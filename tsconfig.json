{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": [
      "es2022"
    ],
    "types": [
      "node",
      "mocha"
    ],
    "outDir": "out",
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}
